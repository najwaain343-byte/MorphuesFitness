<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera is used for MediaPipe motion tracking -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Camera permission -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Internet permission for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MorpheusFitness">

        <!-- REGISTER -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- LOGIN - APP STARTS HERE -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <!-- WORKOUT / CAMERA -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- EXERCISE SELECTION -->
        <activity
            android:name=".ExerciseSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".WorkoutSummaryActivity"
            android:exported="false" />

        <activity
            android:name=".WorkoutHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".HomeActivity"
            android:exported="false" />

    </application>

</manifest>