<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111313"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="25dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#FFC400"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="MORPHEUS"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WORKOUT"
                    android:textColor="#FFC400"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="CHOOSE YOUR"
                android:textColor="#FFFFFF"
                android:textSize="31sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WORKOUT."
                android:textColor="#FFC400"
                android:textSize="38sp"
                android:textStyle="bold|italic" />

            <View
                android:layout_width="65dp"
                android:layout_height="5dp"
                android:layout_marginTop="12dp"
                android:background="#FFC400" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Select an exercise and let Morpheus track your movement in real time."
                android:textColor="#A7AAAA"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- SEARCH BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:background="#242828"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="⌕"
                android:textColor="#FFC400"
                android:textSize="26sp" />

            <EditText
                android:id="@+id/etSearchExercise"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search exercise..."
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#858A8A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFC400"
                android:textSize="25sp"
                android:visibility="gone"
                android:contentDescription="Clear search" />
        </LinearLayout>

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT EXERCISE"
                android:textColor="#777C7C"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- SQUAT CARD -->
            <LinearLayout
                android:id="@+id/cardSquat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#181B1B"
                android:elevation="5dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="#222626"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01"
                        android:textColor="#FFC400"
                        android:textSize="45sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOWER BODY"
                        android:textColor="#757A7A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SQUAT"
                        android:textColor="#FFC400"
                        android:textSize="27sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Build lower-body strength while tracking your squat depth and posture."
                        android:textColor="#A7AAAA"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <Button
                        android:id="@+id/btnSquat"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#FFC400"
                        android:text="START SQUAT   →"
                        android:textColor="#111111"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- PUSH-UP CARD -->
            <LinearLayout
                android:id="@+id/cardPushUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#181B1B"
                android:elevation="5dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="#222626"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02"
                        android:textColor="#FFC400"
                        android:textSize="45sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPPER BODY"
                        android:textColor="#757A7A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PUSH-UP"
                        android:textColor="#FFC400"
                        android:textSize="27sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Train upper-body strength while monitoring elbow movement and body alignment."
                        android:textColor="#A7AAAA"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <Button
                        android:id="@+id/btnPushUp"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#FFC400"
                        android:text="START PUSH-UP   →"
                        android:textColor="#111111"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- PLANK CARD -->
            <LinearLayout
                android:id="@+id/cardPlank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#181B1B"
                android:elevation="5dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="#222626"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="03"
                        android:textColor="#FFC400"
                        android:textSize="45sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CORE STABILITY"
                        android:textColor="#757A7A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PLANK"
                        android:textColor="#FFC400"
                        android:textSize="27sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Improve core stability while Morpheus monitors your body alignment and hold time."
                        android:textColor="#A7AAAA"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <Button
                        android:id="@+id/btnPlank"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#FFC400"
                        android:text="START PLANK   →"
                        android:textColor="#111111"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- NO RESULTS -->
            <LinearLayout
                android:id="@+id/layoutNoResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌕"
                    android:textColor="#FFC400"
                    android:textSize="42sp" />

                <TextView
                    android:id="@+id/tvNoExerciseFound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="NO EXERCISE FOUND"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold|italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Try searching for Squat, Push-Up or Plank."
                    android:textColor="#858A8A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- WORKOUT HISTORY -->
            <Button
                android:id="@+id/btnWorkoutHistory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#202323"
                android:text="VIEW WORKOUT HISTORY"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- BACK TO HOME -->
            <Button
                android:id="@+id/btnBackHome"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#292D2D"
                android:text="←  BACK TO HOME"
                android:textColor="#FFC400"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="TRAIN  •  TRACK  •  IMPROVE"
                android:textColor="#555A5A"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
