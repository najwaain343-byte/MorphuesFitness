<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111313"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="25dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <!-- BRAND -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#FFC400"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="MORPHEUS"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILE"
                    android:textColor="#FFC400"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

            </LinearLayout>


            <!-- TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="MY"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROFILE."
                android:textColor="#FFC400"
                android:textSize="38sp"
                android:textStyle="bold|italic" />

            <View
                android:layout_width="60dp"
                android:layout_height="5dp"
                android:layout_marginTop="10dp"
                android:background="#FFC400" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Manage your personal and fitness information."
                android:textColor="#8A8F8F"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="25dp">


            <!-- ================================================= -->
            <!-- ACCOUNT INFORMATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT INFORMATION"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#181B1B"
                android:orientation="vertical"
                android:padding="16dp">


                <!-- NAME -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FULL NAME"
                    android:textColor="#FFC400"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <EditText
                    android:id="@+id/etProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"
                    android:backgroundTint="#555A5A"
                    android:hint="Enter your name"
                    android:inputType="textPersonName"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666B6B"
                    android:textSize="15sp" />


                <!-- EMAIL -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="EMAIL ADDRESS"
                    android:textColor="#FFC400"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <EditText
                    android:id="@+id/etProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"
                    android:backgroundTint="#3A3E3E"
                    android:enabled="false"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="#8A8F8F"
                    android:textColorHint="#555A5A"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Email address cannot be changed here."
                    android:textColor="#5E6363"
                    android:textSize="9sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PERSONAL INFORMATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="PERSONAL INFORMATION"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#181B1B"
                android:orientation="vertical"
                android:padding="16dp">


                <!-- AGE + GENDER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <!-- AGE -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AGE"
                            android:textColor="#FFC400"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etProfileAge"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="5dp"
                            android:backgroundTint="#555A5A"
                            android:gravity="center_vertical"
                            android:hint="Age"
                            android:inputType="number"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#666B6B"
                            android:textSize="16sp" />

                    </LinearLayout>


                    <!-- GENDER -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GENDER"
                            android:textColor="#FFC400"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinnerGender"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="#FFC400"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- FITNESS INFORMATION -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="FITNESS INFORMATION"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#181B1B"
                android:orientation="vertical"
                android:padding="16dp">


                <!-- HEIGHT + WEIGHT -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <!-- HEIGHT -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HEIGHT"
                            android:textColor="#FFC400"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etProfileHeight"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:backgroundTint="#555A5A"
                                android:hint="Height"
                                android:inputType="numberDecimal"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#666B6B"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="CM"
                                android:textColor="#777C7C"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- WEIGHT -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WEIGHT"
                            android:textColor="#FFC400"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etProfileWeight"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_weight="1"
                                android:backgroundTint="#555A5A"
                                android:hint="Weight"
                                android:inputType="numberDecimal"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#666B6B"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="KG"
                                android:textColor="#777C7C"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <!-- CALORIE EXPLANATION -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Your weight is used to estimate calories burned during workout sessions."
                    android:textColor="#686D6D"
                    android:textSize="9sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- UPDATE PROFILE -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#FFC400"
                android:text="UPDATE PROFILE  →"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold|italic" />


            <!-- ================================================= -->
            <!-- BACK -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnProfileBack"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#292D2D"
                android:text="←  BACK TO DASHBOARD"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="TRAIN  •  TRACK  •  IMPROVE"
                android:textColor="#555A5A"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>