<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">


        <!-- ================= BRAND ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="▲"
                android:textColor="#FFC400"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="MORPHEUS"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>


        <!-- ================= HERO ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:text="STRONGER"
            android:textColor="#FFC400"
            android:textSize="42sp"
            android:textStyle="bold|italic"
            android:letterSpacing="-0.03" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOVEMENT."
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold|italic"
            android:letterSpacing="-0.03" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BETTER YOU."
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold|italic"
            android:letterSpacing="-0.03" />


        <!-- YELLOW ACCENT -->

        <View
            android:layout_width="72dp"
            android:layout_height="5dp"
            android:layout_marginTop="16dp"
            android:background="#FFC400" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="AI-POWERED FITNESS TRACKING"
            android:textColor="#BDBDBD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />


        <!-- ================= LOGIN CARD ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:background="#181B1B"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WELCOME BACK!"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold|italic" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Ready for your next workout?"
                android:textColor="#9E9E9E"
                android:textSize="13sp" />


            <!-- EMAIL LABEL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="EMAIL"
                android:textColor="#FFC400"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:backgroundTint="#777777"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777C7C"
                android:textSize="14sp" />


            <!-- PASSWORD LABEL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="PASSWORD"
                android:textColor="#FFC400"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:backgroundTint="#777777"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777C7C"
                android:textSize="14sp" />


            <!-- LOGIN -->

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#FFC400"
                android:text="START YOUR WORKOUT  →"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold|italic" />


            <!-- REGISTER DIVIDER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#343737" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="NEW TO MORPHEUS?"
                    android:textColor="#777C7C"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#343737" />

            </LinearLayout>


            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="CREATE AN ACCOUNT"
                android:textColor="#FFC400"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================= BOTTOM ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="TRAIN  •  TRACK  •  IMPROVE"
            android:textColor="#555A5A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />

    </LinearLayout>

</ScrollView>