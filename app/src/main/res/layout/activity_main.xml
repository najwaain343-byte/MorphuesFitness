<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0D0D">


    <!-- ===================================================== -->
    <!-- SPORT HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#111313"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">


        <!-- BRAND ICON -->

        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="▲"
            android:textColor="#FFC400"
            android:textSize="22sp"
            android:textStyle="bold" />


        <!-- EXERCISE INFO -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MORPHEUS FITNESS"
                android:textColor="#777C7C"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvExerciseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SQUAT"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold|italic" />

        </LinearLayout>


        <!-- LIVE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFC400"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="● LIVE"
            android:textColor="#111111"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- YELLOW ACCENT -->

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FFC400" />


    <!-- ===================================================== -->
    <!-- CAMERA -->
    <!-- ===================================================== -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">


        <!-- CAMERA PREVIEW -->

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <!--
            MEDIAPIPE OVERLAY

            IMPORTANT:
            Keep this view because MainActivity.java uses it.

            For now it is still visible.
            Later we can hide it without stopping MediaPipe.
        -->

        <com.example.morpheusfitness.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <!-- CAMERA TOP LABEL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="14dp"
            android:background="#CC111313"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="AI MOTION TRACKING"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />


        <!-- FORM FEEDBACK OVER CAMERA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:background="#E6111313"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">


            <!-- STATUS ICON -->

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="#FFC400"
                android:text="✓"
                android:textColor="#111111"
                android:textSize="22sp"
                android:textStyle="bold" />


            <!-- FEEDBACK -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FORM STATUS"
                    android:textColor="#8E9393"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:text="READY"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- SPORT HUD / STATS -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111313"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">


        <!-- SESSION TITLE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION STATS"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold|italic"
                android:letterSpacing="0.07" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="#333737" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- REPS + TIME + CALORIES -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">


            <!-- REPS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#1B1E1E"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REPS / HOLD"
                    android:textColor="#777C7C"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#FFC400"
                    android:textSize="25sp"
                    android:textStyle="bold|italic" />

            </LinearLayout>


            <!-- DURATION -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="#1B1E1E"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME"
                    android:textColor="#777C7C"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- CALORIES -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="#1B1E1E"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KCAL"
                    android:textColor="#777C7C"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0.00"
                    android:textColor="#FFC400"
                    android:textSize="21sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CONTROLS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">


            <Button
                android:id="@+id/btnResetWorkout"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:backgroundTint="#292D2D"
                android:text="RESET"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnFinishWorkout"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:layout_marginStart="5dp"
                android:backgroundTint="#FFC400"
                android:text="FINISH WORKOUT  →"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold|italic" />

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- HIDDEN TECHNICAL VALUES -->
    <!-- DO NOT DELETE - MainActivity.java REFERENCES THEM -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvKneeAngle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Angle: --°" />

        <TextView
            android:id="@+id/tvHipAngle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hip Angle: --°" />

        <TextView
            android:id="@+id/tvTorsoAngle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Torso Angle: --°" />

        <TextView
            android:id="@+id/tvPhase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phase: --" />

    </LinearLayout>

</LinearLayout>