<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="700dp"
        android:orientation="vertical">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111313"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="25dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">


            <!-- BRAND -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#FFC400"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="MORPHEUS"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUMMARY"
                    android:textColor="#FFC400"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

            </LinearLayout>


            <!-- TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="WORKOUT"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COMPLETE."
                android:textColor="#FFC400"
                android:textSize="38sp"
                android:textStyle="bold|italic" />

            <View
                android:layout_width="60dp"
                android:layout_height="5dp"
                android:layout_marginTop="10dp"
                android:background="#FFC400" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Session finished. Review your performance."
                android:textColor="#8A8F8F"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            android:paddingBottom="25dp">


            <!-- ================================================= -->
            <!-- EXERCISE TYPE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPLETED EXERCISE"
                android:textColor="#777C7C"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#181B1B"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">


                <!-- ICON -->

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#FFC400"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSummaryExercise"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SQUAT"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="TRAINING SESSION"
                        android:textColor="#686D6D"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PERFORMANCE SUMMARY -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="SESSION PERFORMANCE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <!-- PERFORMANCE CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#181B1B"
                android:orientation="vertical"
                android:padding="18dp">


                <!-- PERFORMANCE -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PERFORMANCE"
                            android:textColor="#777C7C"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="TOTAL REPS / HOLD"
                            android:textColor="#555A5A"
                            android:textSize="8sp" />

                    </LinearLayout>


                    <TextView
                        android:id="@+id/tvSummaryPerformance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repetitions: 0"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:background="#292D2D" />


                <!-- DURATION -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DURATION"
                            android:textColor="#777C7C"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="TOTAL SESSION TIME"
                            android:textColor="#555A5A"
                            android:textSize="8sp" />

                    </LinearLayout>


                    <TextView
                        android:id="@+id/tvSummaryDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duration: 00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:background="#292D2D" />


                <!-- CALORIES -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CALORIES"
                            android:textColor="#777C7C"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="ESTIMATED ENERGY BURNED"
                            android:textColor="#555A5A"
                            android:textSize="8sp" />

                    </LinearLayout>


                    <TextView
                        android:id="@+id/tvSummaryCalories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calories Burned: 0.00 kcal"
                        android:textColor="#FFC400"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SAVE INFORMATION -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#111313"
                android:orientation="horizontal"
                android:padding="13dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#FFC400"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="Save this session to include it in your workout history and weekly activity."
                    android:textColor="#8A8F8F"
                    android:textSize="9sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SAVE WORKOUT -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnSaveWorkout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#FFC400"
                android:text="SAVE WORKOUT  →"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold|italic" />


            <!-- ================================================= -->
            <!-- BACK -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnBackToExercises"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#292D2D"
                android:text="←  BACK TO EXERCISES"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />


            <!-- FOOTER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="TRAIN  •  TRACK  •  IMPROVE"
                android:textColor="#555A5A"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>