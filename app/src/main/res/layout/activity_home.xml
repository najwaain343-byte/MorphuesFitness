<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ================================================= -->
        <!-- TOP SPORT HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp"
            android:background="#111313">


            <!-- BRAND -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#FFC400"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="MORPHEUS"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FITNESS"
                    android:textColor="#FFC400"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>


            <!-- USER NAME -->

            <TextView
                android:id="@+id/tvWelcomeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Hi! 💪"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- BIG FITNESS HEADING -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="READY TO TRAIN\nTODAY?"
                android:textColor="#FFC400"
                android:textSize="38sp"
                android:textStyle="bold|italic"
                android:lineSpacingExtra="-4dp"
                android:letterSpacing="-0.02" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="TRAIN  •  TRACK  •  IMPROVE"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />


            <!-- YELLOW ACCENT -->

            <View
                android:layout_width="70dp"
                android:layout_height="5dp"
                android:layout_marginTop="18dp"
                android:background="#FFC400" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">


            <!-- SECTION TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S WORKOUT"
                android:textColor="#8E9393"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />


            <!-- ================================================= -->
            <!-- START WORKOUT HERO CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#181B1B"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp">


                <!-- YELLOW LINE -->

                <View
                    android:layout_width="45dp"
                    android:layout_height="4dp"
                    android:background="#FFC400" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="START YOUR"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold|italic" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WORKOUT"
                    android:textColor="#FFC400"
                    android:textSize="31sp"
                    android:textStyle="bold|italic" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="AI-powered motion tracking to monitor your form, repetitions and calories."
                    android:textColor="#BDBDBD"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />


                <Button
                    android:id="@+id/btnStartWorkout"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#FFC400"
                    android:text="START WORKOUT   →"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- QUICK ACCESS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="QUICK ACCESS"
                android:textColor="#8E9393"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">


                <!-- ================================================= -->
                <!-- HISTORY CARD -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="#181B1B"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="▥"
                        android:textColor="#FFC400"
                        android:textSize="30sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="WORKOUT"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold|italic" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HISTORY"
                        android:textColor="#FFC400"
                        android:textSize="20sp"
                        android:textStyle="bold|italic" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="View your progress"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp" />


                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />


                    <Button
                        android:id="@+id/btnWorkoutHistory"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:backgroundTint="#282B2B"
                        android:text="VIEW  →"
                        android:textColor="#FFC400"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- PROFILE CARD -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="#181B1B"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#FFC400"
                        android:textSize="30sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="MY"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold|italic" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROFILE"
                        android:textColor="#FFC400"
                        android:textSize="20sp"
                        android:textStyle="bold|italic" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Manage your details"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp" />


                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />


                    <Button
                        android:id="@+id/btnProfile"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:backgroundTint="#282B2B"
                        android:text="VIEW  →"
                        android:textColor="#FFC400"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MOTIVATION / SPORT CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#FFC400"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">


                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="#111111"
                    android:textSize="27sp"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONSISTENCY"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BUILDS RESULTS."
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Keep moving. Keep improving."
                        android:textColor="#4A3A00"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- LOGOUT -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#202323"
                android:text="LOG OUT"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />


            <!-- BOTTOM BRAND -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="MORPHEUS FITNESS  •  AI MOTION TRACKING"
                android:textColor="#5F6464"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>