<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="#181B1B"
    android:orientation="vertical"
    android:padding="16dp">


    <!-- ================================================= -->
    <!-- TOP -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- ICON -->

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="#FFC400"
            android:gravity="center"
            android:text="▲"
            android:textColor="#111111"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- EXERCISE -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemExercise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SQUAT"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TRAINING SESSION"
                android:textColor="#686D6D"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

        </LinearLayout>


        <!-- DATE -->

        <TextView
            android:id="@+id/tvItemDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="07 OCT&#10;04:15 PM"
            android:textColor="#FFC400"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- DIVIDER -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="#292D2D" />


    <!-- ================================================= -->
    <!-- STATS -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <!-- PERFORMANCE -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERFORMANCE"
                android:textColor="#686D6D"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemPerformance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="12 REPS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- DURATION -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DURATION"
                android:textColor="#686D6D"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="02:35"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- CALORIES -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CALORIES"
                android:textColor="#686D6D"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="8.40 KCAL"
                android:textColor="#FFC400"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- DELETE -->
    <!-- ================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#292D2D" />


    <TextView
        android:id="@+id/btnDeleteWorkout"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="end"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="4dp"
        android:text="DELETE WORKOUT"
        android:textColor="#FF5252"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

</LinearLayout>